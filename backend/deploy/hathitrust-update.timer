# Example only (nothing installs this). Runs hathitrust-update.service every night. See that file for installing.
[Unit]
Description=Nightly refresh of the HathiTrust search index

[Timer]
OnCalendar=*-*-* 05:30:00 UTC
# If the server was off at 05:30, run once when it is back on.
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
