# --- Secrets and local config ---
# Top-level .env holds name/email (see .env.example); gutendex/gutendex/.env holds Django secrets.
.env
**/.env
!.env.example
!**/.env.template

# --- OS / editors ---
.DS_Store
.vscode/
.idea/
*.swp
*.iml

# --- Python (backend/, gutendex/) ---
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
db.sqlite3
backend/cache/

# --- Flutter / Dart (app/) ---
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
coverage/

# --- Gutendex data (2+ GB, rebuilt by `manage.py updatecatalog`) ---
gutendex/catalog_files/
gutendex/updatecatalog.out
gutendex/media/
